{
  "name": "frontend",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --mode prod",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "stylelint": "stylelint '**/*.{tsx,css}'",
    "stylelint:fix": "stylelint --fix '**/*.{tsx,css}'",
    "generate-types": "swagger-typescript-api generate --path https://teamkatalog-api.intern.dev.nav.no/v3/api-docs --output ./src/types --no-client -r -n teamcat-models",
    "check-types": "tsc --noemit",
    "all-checks": "npm run check-types && npm run lint && npm run stylelint",
    "fixes": "npm run lint:fix && npm run stylelint:fix"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/faro-web-sdk": "2.9.0",
    "@grafana/faro-web-tracing": "2.9.0",
    "@hookform/resolvers": "5.9.1",
    "@navikt/aksel-icons": "8.16.1",
    "@navikt/ds-css": "8.16.1",
    "@navikt/ds-react": "8.16.1",
    "@navikt/react-json-view-compare": "2.2.0",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.19.0",
    "date-fns": "4.4.0",
    "dayjs": "1.11.23",
    "lodash": "4.18.1",
    "query-string": "9.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.2",
    "react-select": "5.10.2",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@navikt/aksel": "8.16.1",
    "@navikt/aksel-stylelint": "8.16.1",
    "@tanstack/react-query-devtools": "5.101.4",
    "@types/lodash": "4.17.25",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-lodash": "8.0.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-jsx": "5.18.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "73.0.0",
    "eslint-plugin-you-dont-need-lodash-underscore": "6.14.0",
    "postcss-styled-syntax": "0.7.2",
    "prettier": "3.9.6",
    "react-localization": "2.0.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "swagger-typescript-api": "13.12.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2"
  }
}
